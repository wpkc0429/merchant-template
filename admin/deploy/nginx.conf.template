# nginx config for the merchant ADMIN static files (admin/). A TEMPLATE for the official nginx image:
# the image runs envsubst over /etc/nginx/templates/*.template at start-up and substitutes ONLY the
# environment variables that are set (nginx's own $uri etc. are left alone). See admin/deploy/Dockerfile.
#
# Topology (docs/deploy/admin-exposure-runbook.md of the platform, admin/README.md "部署"): the admin is
# served on its OWN hostname, same-origin with the API, behind Cloudflare Access:
#
#   browser --> admin.<shop-domain> --(Cloudflare Access)--> tunnel
#                 |-- ^/api/v1/admin --> the platform API   (tunnel rule, see cloudflared-ingress.example.yml)
#                 `-- everything else --> THIS nginx (static files)
#
# so this server never proxies the API and needs no CORS. Required environment variables:
#   ADMIN_IMG_ORIGIN     origin that serves product images (the platform's IMAGE_PUBLIC_BASE_URL origin),
#                        e.g. https://img.example.com
#   ADMIN_UPLOAD_ORIGIN  the R2 / S3 origin the browser PUTs image uploads to (direct upload),
#                        e.g. https://<account-id>.r2.cloudflarestorage.com  (media-r2-setup.md)
#   ADMIN_SITE_ORIGIN    the storefront origin, e.g. https://www.example.com . Used for (1) the content PREVIEW button (served to
#                        the page as /site-config.js) and (2) /content.schema.json, which this server reads from the storefront so
#                        the store owner can dry-run and register the content schema from the admin (same-origin for the browser,
#                        so the CSP connect-src stays 'self').
#
# THE CSP BELOW IS REQUIRED, NOT OPTIONAL (decided 2026-11-25, docs/DECISIONS.md): production and every AI-edit preview
# environment must serve it. Do not delete, comment out, loosen (unsafe-inline / unsafe-eval / wildcards) or make it
# conditional; scripts/check-design.mjs (step "deploy") fails when it is missing or weakened. To allow another origin
# (image host, upload host) change the environment variables, not the policy.
# The CSP below is the strict one from admin/README.md and admin/docs/AI-EDIT-SERVICE-NOTES.md, adapted to
# the template (no third-party fonts: style-src and font-src are 'self' only). The core has no inline
# scripts or styles, so no 'unsafe-inline'. `worker-src blob:` is for the vendored HEIC converter's worker.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob: ${ADMIN_IMG_ORIGIN}; connect-src 'self' ${ADMIN_UPLOAD_ORIGIN}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # Transport and browser-feature hardening (the CSP above is unchanged). HSTS is only honoured over https, which
    # Cloudflare terminates in front of this server.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # No filename hashes, so no long caching: browsers revalidate and a publish takes effect at once.
    add_header Cache-Control "no-cache" always;

    # Never serve local overrides or anything that is not a published file, even if one slips into the image.
    location ~ /(config\.local\.js|\.|scripts/|e2e/|docs/|deploy/) { return 404; }

    # Content store: the admin page reads these two same-origin paths (the storefront origin comes from ADMIN_SITE_ORIGIN).
    location = /site-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache" always;
        return 200 'window.ADMIN_CONFIG.siteOrigin = "${ADMIN_SITE_ORIGIN}";';
    }
    location = /content.schema.json {
        proxy_pass ${ADMIN_SITE_ORIGIN}/content.schema.json;
        proxy_ssl_server_name on;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "no-store" always;
    }

    location / {
        try_files $uri /index.html;
    }
}
