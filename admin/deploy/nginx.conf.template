# nginx config for the merchant ADMIN static files (admin/). A TEMPLATE for the official nginx image:
# the image runs envsubst over /etc/nginx/templates/*.template at start-up and substitutes ONLY the
# environment variables that are set (nginx's own $uri etc. are left alone). See admin/deploy/Dockerfile.
#
# Topology (docs/deploy/admin-exposure-runbook.md of the platform, admin/README.md "部署"): the admin is
# served on its OWN hostname, same-origin with the API, behind Cloudflare Access:
#
#   browser --> admin.<shop-domain> --(Cloudflare Access)--> tunnel
#                 |-- ^/api/v1/admin --> the platform API   (tunnel rule, see cloudflared-ingress.example.yml)
#                 `-- everything else --> THIS nginx (static files)
#
# so this server never proxies the API and needs no CORS. Required environment variables:
#   ADMIN_IMG_ORIGIN     origin that serves product images (the platform's IMAGE_PUBLIC_BASE_URL origin),
#                        e.g. https://img.example.com
#   ADMIN_UPLOAD_ORIGIN  the R2 / S3 origin the browser PUTs image uploads to (direct upload),
#                        e.g. https://<account-id>.r2.cloudflarestorage.com  (media-r2-setup.md)
#                        IT MUST ALSO COVER THE HOST OF THE PLATFORM'S SIGNED SCREENSHOT URLS (design-history review, decision D14):
#                        the same object-storage account endpoint (the second, private design-history bucket lives on the same account).
#                        If it does not, the review dialog cannot load any screenshot (connect-src blocks the fetch).
#   ADMIN_SITE_ORIGIN    the storefront origin, e.g. https://www.example.com . Used for (1) the content PREVIEW button (served to
#                        the page as /site-config.js) and (2) /content.schema.json, which this server reads from the storefront so
#                        the store owner can dry-run and register the content schema from the admin (same-origin for the browser,
#                        so the CSP connect-src stays 'self'). Must match ^https://[a-z0-9.-]+(:[0-9]+)?$ (no trailing slash, no path);
#                        the image's start-up check (deploy/Dockerfile) refuses anything else.
#   (set by the image itself) ADMIN_RESOLVER  the DNS server nginx uses to look ADMIN_SITE_ORIGIN up at REQUEST time (first
#                        nameserver of /etc/resolv.conf). The schema proxy uses a variable proxy_pass + resolver, so the admin
#                        starts even when the storefront hostname does not resolve yet (nginx would otherwise refuse to start).
#
# THE CSP BELOW IS REQUIRED, NOT OPTIONAL (decided 2026-11-25, docs/DECISIONS.md): production and every AI-edit preview
# environment must serve it. Do not delete, comment out, loosen (unsafe-inline / unsafe-eval / wildcards) or make it
# conditional; scripts/check-design.mjs (step "deploy") fails when it is missing or weakened. To allow another origin
# (image host, upload host) change the environment variables, not the policy.
# THE ONE EXTRA script-src TOKEN (decision D19): 'sha256-...' is the hash of the exact text of the inline <script type="importmap"> in index.html. That map is
# what keeps a design module from importing the core (lib/, core/, ui/); without the hash the browser silently IGNORES the map. It is NOT 'unsafe-inline' and allows
# no other inline text. If index.html's import map changes, run `node scripts/check-design.mjs --update` (locked-file flow, a human step): it recomputes the hash
# and rewrites it here; scripts/check-design.mjs (step "deploy") fails when the two disagree. The app also checks at start-up (lib/canary-probe.js) that the
# map is in effect and turns the design layer off if it is not.
# The CSP below is the strict one from admin/README.md and admin/docs/AI-EDIT-SERVICE-NOTES.md, adapted to
# the template (no third-party fonts: style-src and font-src are 'self' only). The core has no inline
# scripts or styles, so no 'unsafe-inline'. `worker-src blob:` is for the vendored HEIC converter's worker.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers. nginx does NOT inherit add_header into a location that has its own add_header, so every location
    # below that sets one repeats this whole block (tests/nginx-config.test.mjs checks that each location has all of them).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-bL9OnHZ7Slc2AfZDmtSWho9iVIcBPuM2eCK5SLXf7VU='; style-src 'self'; font-src 'self'; img-src 'self' data: blob: ${ADMIN_IMG_ORIGIN}; connect-src 'self' ${ADMIN_UPLOAD_ORIGIN}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # No filename hashes, so no long caching: browsers revalidate and a publish takes effect at once.
    add_header Cache-Control "no-cache" always;

    # The import map sends every module a design file tries to import outside /design/ to /deny/ (index.html, D19): it must answer 404 and nothing else. (It inherits
    # the server-level headers: no add_header here.)
    location ^~ /deny/ { return 404; }

    # A design file never needs a percent sign in a path (design file names are letters, digits, . _ - only). A percent-encoded `..%2f` in /design/ would be
    # decoded by nginx into a path OUTSIDE /design/ while the browser (and its import map) still sees a URL inside /design/, so it is refused here.
    if ($request_uri ~* "^/design/[^?]*%") { return 404; }

    # Never serve local overrides or anything that is not a published file, even if one slips into the image.
    location ~ /(config\.local\.js|\.|scripts/|e2e/|docs/|deploy/) { return 404; }

    # Content store: the admin page reads these two same-origin paths (the storefront origin comes from ADMIN_SITE_ORIGIN).
    location = /site-config.js {
        default_type application/javascript;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-bL9OnHZ7Slc2AfZDmtSWho9iVIcBPuM2eCK5SLXf7VU='; style-src 'self'; font-src 'self'; img-src 'self' data: blob: ${ADMIN_IMG_ORIGIN}; connect-src 'self' ${ADMIN_UPLOAD_ORIGIN}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Cache-Control "no-cache" always;
        return 200 'window.ADMIN_CONFIG.siteOrigin = "${ADMIN_SITE_ORIGIN}";';
    }

    # The storefront's content.schema.json, read server-side so the browser stays same-origin (CSP connect-src 'self').
    # Hardened: GET/HEAD only; nothing of the admin session (cookies, Cloudflare Access JWT, Authorization) is forwarded;
    # no body, no redirects followed, short timeouts; upstream cookies/headers/Content-Type are dropped and replaced.
    # A variable proxy_pass + resolver: the hostname is resolved per request, not at nginx start.
    location = /content.schema.json {
        limit_except GET { deny all; }
        resolver ${ADMIN_RESOLVER} valid=30s ipv6=off;
        set $schema_upstream "${ADMIN_SITE_ORIGIN}/content.schema.json";
        proxy_pass $schema_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_set_header Cf-Access-Authenticated-User-Email "";
        proxy_set_header CF_Authorization "";
        proxy_set_header X-Preview-Token "";
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
        proxy_redirect off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Content-Type;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header Cache-Control;
        proxy_hide_header Access-Control-Allow-Origin;
        default_type application/json;
        add_header Content-Type "application/json" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Cache-Control "no-store" always;
    }

    location / {
        try_files $uri /index.html;
    }
}
